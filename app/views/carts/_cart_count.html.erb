<%= link_to cart_path, class: "relative hover:text-[#FACC15]" do %>
  <i class="fas fa-shopping-cart text-lg"></i>

  <% total_items = current_cart.cart_items.sum(:quantity) %>
  <% if total_items.positive? %>
    <span class="absolute -top-2 -right-3 bg-white text-[#F97316] text-xs font-bold rounded-full px-2 py-0.5">
      <%= total_items %>
    </span>
  <% end %>
<% end %>
